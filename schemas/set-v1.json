{
    "$id": "https://swolegen.app/schemas/set-v1.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "Structured set reference.",
    "properties": {
        "accomplished": {
            "additionalProperties": false,
            "description": "The actual completed set for this exercise; null if unknown.",
            "properties": {
                "rep_bracket": {
                    "description": "Rep range or count (e.g., \"8-10\" or \"10\").",
                    "type": "string"
                },
                "resistance": {
                    "additionalProperties": false,
                    "properties": {
                        "bodyweight": {
                            "description": "Set to true when mode=bodyweight. Set to null otherwise.",
                            "type": [
                                "boolean",
                                "null"
                            ]
                        },
                        "durationSec": {
                            "description": "Duration in seconds; required when mode=duration. Set to null otherwise.",
                            "minimum": 1,
                            "type": [
                                "number",
                                "null"
                            ]
                        },
                        "lbs": {
                            "description": "Additional load in pounds; required when mode=lbs. Set to null otherwise.",
                            "minimum": 1,
                            "type": [
                                "number",
                                "null"
                            ]
                        },
                        "mode": {
                            "description": "Discriminator: choose exactly one mode and set the corresponding field. Do not include unused fields.",
                            "enum": [
                                "lbs",
                                "duration",
                                "bodyweight"
                            ],
                            "type": "string"
                        }
                    },
                    "required": [
                        "mode",
                        "lbs",
                        "bodyweight",
                        "durationSec"
                    ],
                    "type": "object"
                }
            },
            "required": [
                "rep_bracket",
                "resistance"
            ],
            "type": [
                "object",
                "null"
            ]
        },
        "equipment": {
            "description": "Canonical equipment keys. If any required item is not listed, include \"eq_other\" and list free-text names in equipment_other; set equipment_other to null otherwise. Some exercises require a barbell and plates (like deadlifts), list both in equipment.",
            "items": {
                "enum": [
                    "eq_bodyweight",
                    "eq_dumbbells_set_5-50lbs",
                    "eq_dumbbells_set_55-100lbs",
                    "eq_kettlebells_set_5-35lbs",
                    "eq_kettlebells_set_40-70lbs",
                    "eq_barbell_45lbs",
                    "eq_olympic_barbell_mens_20kg",
                    "eq_olympic_barbell_womens_15kg",
                    "eq_weight_plates_5-25lbs",
                    "eq_weight_plates_25-45lbs",
                    "eq_flat_bench",
                    "eq_adjustable_bench",
                    "eq_hip_thrust_bench_or_pad",
                    "eq_step_platform",
                    "eq_plyo_box",
                    "eq_power_rack",
                    "eq_squat_stand",
                    "eq_smith_machine",
                    "eq_cable_machine_single_stack",
                    "eq_cable_machine_dual_stack",
                    "eq_lat_pulldown",
                    "eq_seated_row",
                    "eq_cable_attachments_basic",
                    "eq_cable_attachments_full",
                    "eq_bands_light_medium",
                    "eq_bands_full",
                    "eq_pullup_bar",
                    "eq_assisted_pullup",
                    "eq_dip_bars",
                    "eq_mat_area",
                    "eq_treadmill",
                    "eq_stationary_bike",
                    "eq_air_bike",
                    "eq_elliptical",
                    "eq_rower",
                    "eq_stair_climber",
                    "eq_sled_and_turf",
                    "eq_other"
                ],
                "type": "string"
            },
            "maxItems": 10,
            "minItems": 1,
            "type": "array"
        },
        "equipment_notes": {
            "description": "Short notes about equipment constraints or specifics.",
            "maxLength": 200,
            "type": [
                "string",
                "null"
            ]
        },
        "equipment_other": {
            "description": "Free-text equipment required when using eq_other. Set to null otherwise. Note that Bodyweight is not a valid value here, rather use eq_bodyweight.",
            "items": {
                "minLength": 1,
                "type": "string"
            },
            "type": [
                "array",
                "null"
            ]
        },
        "notes": {
            "description": "Free-form notes about the exercise; set to null if none.",
            "type": [
                "string",
                "null"
            ]
        },
        "pattern": {
            "description": "The Fundamental Movement pattern classification(s) for this exercise.",
            "items": {
                "enum": [
                    "horizontal_push",
                    "horizontal_pull",
                    "vertical_push",
                    "vertical_pull",
                    "squat",
                    "hinge",
                    "rotation"
                ],
                "type": "string"
            },
            "maxItems": 2,
            "minItems": 1,
            "type": "array"
        },
        "slug": {
            "description": "Canonical exercise slug, kebab-case (e.g., \"barbell-bench-press\").",
            "type": "string"
        },
        "tier_hint": {
            "description": "Priority tier: A = must-do, B = nice-to-have, C = stretch goals.",
            "enum": [
                "A",
                "B",
                "C"
            ],
            "type": "string"
        }
    },
    "required": [
        "slug",
        "pattern",
        "equipment",
        "equipment_other",
        "equipment_notes",
        "tier_hint",
        "accomplished",
        "notes"
    ],
    "title": "SwoleGen Set (v1)",
    "type": "object"
}