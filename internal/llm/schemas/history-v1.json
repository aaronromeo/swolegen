{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swolegen.app/schemas/history-v1.json",
  "title": "SwoleGen Workout History (v1)",
  "description": "Structured history of a user’s workouts based on data provided.",
  "type": "object",
  "required": [
    "most_recent_sets",
    "recent_best_sets_30d"
  ],
  "properties": {
    "most_recent_sets": {
      "description": "Comprehensive array of every set of every exercise in every workout that the user has performed in the past 30 days, ordered by recency (most recent first).",
      "type": "array",
      "maxItems": 3,
      "minItems": 0,
      "items": {
        "type": "object",
        "required": [
          "workout_date",
          "sets"
        ],
        "properties": {
          "sets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/set-v1"
            }
          },
          "workout_date": {
            "description": "Workout date in YYYY-MM-DD.",
            "type": "string",
            "format": "date"
          }
        },
        "additionalProperties": false
      }
    },
    "recent_best_sets_30d": {
      "description": "Array of objects representing the user's most recent best effort sets within the last 30 days. Each entry contains a set object and its estimated_workout_date. Entries should appear at most once, ordered by recency (most recent first). Must contain between 1 and 90 entries. Use this to bias selection and progression toward movements with fresh performance signals.",
      "type": "array",
      "maxItems": 90,
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "set",
          "estimated_workout_date"
        ],
        "properties": {
          "estimated_workout_date": {
            "description": "Estimated workout date in YYYY-MM-DD.",
            "type": "string",
            "format": "date"
          },
          "set": {
            "$ref": "#/$defs/set-v1"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "set-v1": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://swolegen.app/schemas/set-v1.json",
      "title": "SwoleGen Set (v1)",
      "description": "Structured set reference.",
      "type": "object",
      "required": [
        "slug",
        "pattern",
        "equipment",
        "equipment_other",
        "equipment_notes",
        "tier_hint",
        "accomplished",
        "notes"
      ],
      "properties": {
        "pattern": {
          "description": "The Fundamental Movement pattern classification(s) for this exercise.",
          "type": "array",
          "maxItems": 2,
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "horizontal_push",
              "horizontal_pull",
              "vertical_push",
              "vertical_pull",
              "squat",
              "hinge",
              "rotation"
            ]
          }
        },
        "accomplished": {
          "description": "The actual completed set for this exercise; null if unknown.",
          "type": [
            "object",
            "null"
          ],
          "required": [
            "rep_bracket",
            "resistance"
          ],
          "properties": {
            "rep_bracket": {
              "description": "Rep range or count (e.g., \"8-10\" or \"10\").",
              "type": "string"
            },
            "resistance": {
              "type": "object",
              "required": [
                "mode",
                "lbs",
                "bodyweight",
                "durationSec"
              ],
              "properties": {
                "bodyweight": {
                  "description": "Set to true when mode=bodyweight. Set to null otherwise.",
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "durationSec": {
                  "description": "Duration in seconds; required when mode=duration. Set to null otherwise.",
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 1
                },
                "lbs": {
                  "description": "Additional load in pounds; required when mode=lbs. Set to null otherwise.",
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 1
                },
                "mode": {
                  "description": "Discriminator: choose exactly one mode and set the corresponding field. Do not include unused fields.",
                  "type": "string",
                  "enum": [
                    "lbs",
                    "duration",
                    "bodyweight"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "equipment": {
          "description": "Canonical equipment keys. If any required item is not listed, include \"eq_other\" and list free-text names in equipment_other; set equipment_other to null otherwise. Some exercises require a barbell and plates (like deadlifts), list both in equipment.",
          "type": "array",
          "maxItems": 10,
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "eq_bodyweight",
              "eq_dumbbells_set_5-50lbs",
              "eq_dumbbells_set_55-100lbs",
              "eq_kettlebells_set_5-35lbs",
              "eq_kettlebells_set_40-70lbs",
              "eq_barbell_45lbs",
              "eq_olympic_barbell_mens_20kg",
              "eq_olympic_barbell_womens_15kg",
              "eq_weight_plates_5-25lbs",
              "eq_weight_plates_25-45lbs",
              "eq_flat_bench",
              "eq_adjustable_bench",
              "eq_hip_thrust_bench_or_pad",
              "eq_step_platform",
              "eq_plyo_box",
              "eq_power_rack",
              "eq_squat_stand",
              "eq_smith_machine",
              "eq_cable_machine_single_stack",
              "eq_cable_machine_dual_stack",
              "eq_lat_pulldown",
              "eq_seated_row",
              "eq_cable_attachments_basic",
              "eq_cable_attachments_full",
              "eq_bands_light_medium",
              "eq_bands_full",
              "eq_pullup_bar",
              "eq_assisted_pullup",
              "eq_dip_bars",
              "eq_mat_area",
              "eq_treadmill",
              "eq_stationary_bike",
              "eq_air_bike",
              "eq_elliptical",
              "eq_rower",
              "eq_stair_climber",
              "eq_sled_and_turf",
              "eq_other"
            ]
          }
        },
        "equipment_notes": {
          "description": "Short notes about equipment constraints or specifics.",
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "equipment_other": {
          "description": "Free-text equipment required when using eq_other. Set to null otherwise. Note that Bodyweight is not a valid value here, rather use eq_bodyweight.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notes": {
          "description": "Free-form notes about the exercise; set to null if none.",
          "type": [
            "string",
            "null"
          ]
        },
        "slug": {
          "description": "Canonical exercise slug, kebab-case (e.g., \"barbell-bench-press\").",
          "type": "string"
        },
        "tier_hint": {
          "description": "Priority tier: A = must-do, B = nice-to-have, C = stretch goals.",
          "type": "string",
          "enum": [
            "A",
            "B",
            "C"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
